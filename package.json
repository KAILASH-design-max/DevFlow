{
  "name": "devflow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "pnpm --filter @devflow/api start",
    "postinstall": "pnpm db:generate",
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "pnpm --filter @devflow/tests-e2e run test",
    "test:e2e": "pnpm --filter @devflow/tests-e2e run test",
    "test:api": "pnpm --filter @devflow/tests-e2e run test:api",
    "test:browser": "pnpm --filter @devflow/tests-e2e run test:browser",
    "db:generate": "pnpm --filter @devflow/database db:generate",
    "db:push": "pnpm --filter @devflow/database db:push",
    "db:migrate": "pnpm --filter @devflow/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @devflow/database db:migrate:deploy",
    "db:reset": "pnpm --filter @devflow/database db:reset",
    "db:seed": "pnpm --filter @devflow/database db:seed",
    "db:seed:firestore": "pnpm --filter @devflow/api exec tsx src/scripts/seedFirestore.ts",
    "db:seed:all": "pnpm db:seed && pnpm db:seed:firestore",
    "db:studio": "pnpm --filter @devflow/database db:studio",
    "cli:build": "pnpm --filter @devflow/cli run build",
    "cli:dev": "pnpm --filter @devflow/cli run dev",
    "cli:link": "pnpm --filter @devflow/cli link --global",
    "cli:run": "node apps/cli/dist/index.js"
  },
  "devDependencies": {
    "@neon/config": "^1.1.0",
    "@neon/env": "^1.1.6",
    "turbo": "^2.3.0"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0",
    "dotenv": "^16.4.5"
  },
  "pnpm": {
    "overrides": {
      "qs": ">=6.16.0",
      "tmp": ">=0.2.4",
      "postcss": ">=8.5.23",
      "sharp": ">=0.35.4",
      "deepmerge-ts": ">=8.0.2",
      "uuid": ">=11.1.1"
    }
  }
}
