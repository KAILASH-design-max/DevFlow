# ==============================================================================
# DevFlow Environment Configuration Template (.env.example)
# ==============================================================================

# ─── Neon PostgreSQL Database ────────────────────────────────────────────────
# Pooled Connection URL (used by Prisma Client for application queries)
# Format: postgresql://[user]:[password]@[endpoint]-pooler.us-east-2.aws.neon.tech/[dbname]?sslmode=require
# Or Local: postgresql://postgres:postgres@localhost:5432/devflow?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devflow?schema=public"

# Direct Connection URL (Used by Prisma for DDL schema migrations when using connection poolers)
# Format: postgresql://[user]:[password]@[endpoint].us-east-2.aws.neon.tech/[dbname]?sslmode=require
DIRECT_URL=""

# Neon Auth URL (OAuth2 / Identity provider)
NEON_AUTH_URL="https://[endpoint].neonauth.c-2.us-east-2.aws.neon.tech/[dbname]/auth"
NEXT_PUBLIC_NEON_AUTH_URL="https://[endpoint].neonauth.c-2.us-east-2.aws.neon.tech/[dbname]/auth"

# Neon Data API (REST endpoint)
NEON_API_URL="https://[endpoint].apirest.c-2.us-east-2.aws.neon.tech/[dbname]/rest/v1"
NEXT_PUBLIC_NEON_API_URL="https://[endpoint].apirest.c-2.us-east-2.aws.neon.tech/[dbname]/rest/v1"

# ─── JWT & Authentication ───────────────────────────────────────────────────
JWT_SECRET="dF!9xQ#mK7$pL2vR8@wN3hY6&jT0cA5eB4gU1sZ"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ─── Express API Server ──────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ─── Third-Party Webhooks & Security Signatures ──────────────────────────────
GITHUB_WEBHOOK_SECRET="whsec_devflow_local_test_key_xyz"
PAYMENT_WEBHOOK_SECRET="whsec_devflow_payment_test_secret_9988"
GEMINI_API_KEY=""

# ─── Next.js Frontend ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_USE_FIRESTORE=false

# ─── Email & SMTP Dispatch (for Real Email OTP Delivery) ─────────────────────
# Leave empty in development to log OTP codes directly to terminal
# For real Gmail delivery: Set SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, your Gmail & 16-character App Password
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM='"DevFlow Security" <security@devflow.io>'

