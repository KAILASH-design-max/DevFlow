# ==============================================================================
# DevFlow Environment Configuration Template (.env.example)
# Copy this file to .env and provide your secret values.
# ==============================================================================

# ─── 1. PostgreSQL Database & Prisma ORM ─────────────────────────────────────
# Pooled Connection URL (used by Prisma Client for application queries)
# Format (Neon): postgresql://[user]:[password]@[endpoint]-pooler.us-east-2.aws.neon.tech/[dbname]?sslmode=require
# Format (Local): postgresql://postgres:postgres@localhost:5432/devflow?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devflow?schema=public"

# Direct Connection URL (Used by Prisma for DDL schema migrations when using poolers)
# Format (Neon): postgresql://[user]:[password]@[endpoint].us-east-2.aws.neon.tech/[dbname]?sslmode=require
DIRECT_URL=""

# Neon Auth URL (OAuth2 / Identity provider - optional)
NEON_AUTH_URL=""
NEXT_PUBLIC_NEON_AUTH_URL=""

# Neon Data API (REST endpoint - optional)
NEON_API_URL=""
NEXT_PUBLIC_NEON_API_URL=""

# ─── 2. JWT & Security Secrets ────────────────────────────────────────────────
# High-entropy random cryptographic key (at least 32 characters in production)
JWT_SECRET="dF!9xQ#mK7$pL2vR8@wN3hY6&jT0cA5eB4gU1sZ"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# HMAC secret for email OTP hashing
OTP_HASH_SECRET="devflow-otp-hash-secret-hmac-32b"

# AES-256 encryption key (32 bytes) for sensitive third-party credentials (e.g. GitHub tokens)
ENCRYPTION_KEY="devflow-default-encryption-secret-key-32b"

# Secret for signed attachment download URLs
URL_SIGNING_SECRET=""

# ─── 3. Express API Server & CORS ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Allowed frontend origins (comma-separated if multiple, e.g. http://localhost:3000,https://app.devflow.io)
CORS_ORIGIN="http://localhost:3000"

# ─── 4. Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─── 5. AI Engineering Intelligence ──────────────────────────────────────────
# Options: "gemini" | "openai" | "mock"
AI_PROVIDER="gemini"
# Google Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=""
# Optional OpenAI fallback
OPENAI_API_KEY=""

# ─── 6. Email & SMTP Dispatch (OTP & Notifications) ──────────────────────────
# In local development: leave empty to log OTP codes directly to terminal
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, your Gmail address & 16-char App Password
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM='"DevFlow Security" <security@devflow.io>'

# ─── 7. File Storage Driver (Local / S3) ──────────────────────────────────────
# Options: "local" | "s3"
STORAGE_DRIVER="local"
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=10

# S3 / Cloudflare R2 / MinIO configuration (required if STORAGE_DRIVER=s3)
AWS_REGION="us-east-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET="devflow-attachments"
S3_ENDPOINT=""

# ─── 8. GitHub Integration & Webhooks ─────────────────────────────────────────
# GitHub OAuth App credentials
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:4000/api/github/oauth/callback"
# Secret configured in your GitHub repository webhook settings
GITHUB_WEBHOOK_SECRET="whsec_devflow_local_test_key_xyz"

# ─── 9. Billing & Payment Webhooks ────────────────────────────────────────────
# Stripe / Payment webhook signing secret
STRIPE_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET="whsec_devflow_payment_test_secret_9988"

# ─── 10. Next.js Frontend Configuration ───────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_USE_FIRESTORE=false
