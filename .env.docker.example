# ==============================================================================
# DevFlow Docker Environment Configuration
# Copy this file to .env before running `docker compose up -d`
# ==============================================================================

# PostgreSQL Container Configuration
POSTGRES_USER=devflow
POSTGRES_PASSWORD=devflow_secret_password_change_me
POSTGRES_DB=devflow_db
POSTGRES_PORT=5432

# Express API Configuration
API_PORT=4000
JWT_SECRET=super_secure_random_jwt_secret_key_at_least_32_chars_long
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
DEMO_SEED=true

# AI & Third-Party Integrations (Optional)
GEMINI_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Next.js Web Frontend Configuration
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
