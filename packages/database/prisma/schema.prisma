// DevFlow — Prisma Schema
// Target Database: Neon PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// Authentication & Users
// ─────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  workspaceMembers  WorkspaceMember[]
  projectMembers    ProjectMember[]
  assignedIssues    Issue[]          @relation("AssignedIssues")
  reportedIssues    Issue[]          @relation("ReportedIssues")
  comments          Comment[]
  attachments       Attachment[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  refreshTokens     RefreshToken[]
  workLogs         WorkLog[]
  sessions         Session[]

  // Extended Profile
  bio              String?
  title            String?
  timezone         String?
  githubUsername   String?
  themePreference  String?
  
  notificationSetting NotificationSetting?

  // 2FA
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  twoFactorRecoveryCodes String?

  // Email Verification State
  emailVerified    Boolean             @default(false)
  emailVerifiedAt  DateTime?
  emailVerifications EmailVerification[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  family    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
// Sessions
// ─────────────────────────────────────────────

model Session {
  id         String   @id @default(cuid())
  device     String?
  browser    String?
  os         String?
  ip         String?
  location   String?
  lastActive DateTime @default(now())
  isCurrent  Boolean  @default(false)
  userId     String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─────────────────────────────────────────────
// Workspace (Top-level organization)
// ─────────────────────────────────────────────

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members      WorkspaceMember[]
  projects     Project[]
  
  securityPolicy WorkspaceSecurityPolicy?
  invitations    WorkspaceInvitation[]
  subscription   WorkspaceSubscription?
  invoices       BillingInvoice[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String @id @default(cuid())
  userId      String
  workspaceId String
  role        String @default("DEVELOPER") // ADMIN, PROJECT_MANAGER, DEVELOPER, TESTER, VIEWER

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("workspace_members")
}

// ─────────────────────────────────────────────
// Projects
// ─────────────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  name        String
  key         String // e.g., "DF", "SS" — unique per workspace
  description String?
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   ProjectMember[]
  issues    Issue[]
  labels    Label[]
  sprints   Sprint[]
  repository Repository?
  deployments Deployment[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("projects")
}

model ProjectMember {
  id        String @id @default(cuid())
  userId    String
  projectId String
  role      String @default("DEVELOPER") // ADMIN, PROJECT_MANAGER, DEVELOPER, TESTER, VIEWER

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([projectId])
  @@map("project_members")
}

// ─────────────────────────────────────────────
// Issues (Core entity)
// ─────────────────────────────────────────────

model Issue {
  id          String   @id @default(cuid())
  number      Int // Auto-incremented per project (e.g., SS-1, SS-2)
  title       String
  description String?
  type        String   @default("TASK") // BUG, TASK, FEATURE, STORY
  status      String   @default("BACKLOG") // BACKLOG, TODO, IN_PROGRESS, IN_REVIEW, TESTING, DONE
  priority    String   @default("MEDIUM") // CRITICAL, HIGH, MEDIUM, LOW
  storyPoints Int?
  dueDate     DateTime?
  position    Int      @default(0) // For ordering within a status column

  projectId  String
  assigneeId String?
  reporterId String
  sprintId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?    @relation("AssignedIssues", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter User     @relation("ReportedIssues", fields: [reporterId], references: [id])
  sprint   Sprint?  @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  labels       IssueLabel[]
  comments     Comment[]
  attachments  Attachment[]
  subtasks     Issue[]       @relation("SubtaskRelation")
  parent       Issue?        @relation("SubtaskRelation", fields: [parentId], references: [id])
  parentId     String?
  pullRequests PullRequest[]
  workLogs     WorkLog[]
  commits      GitCommit[]

  estimatedHours Float?
  loggedHours    Float    @default(0)

  // AI analysis result stored as JSON string
  aiAnalysis String?

  @@unique([projectId, number])
  @@index([projectId])
  @@index([assigneeId])
  @@index([sprintId])
  @@index([status])
  @@index([priority])
  @@map("issues")
}

// ─────────────────────────────────────────────
// Labels (Many-to-many with Issues)
// ─────────────────────────────────────────────

model Label {
  id        String @id @default(cuid())
  name      String
  color     String @default("#6366f1") // Indigo default
  projectId String

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  IssueLabel[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("labels")
}

model IssueLabel {
  id      String @id @default(cuid())
  issueId String
  labelId String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([issueId, labelId])
  @@map("issue_labels")
}

// ─────────────────────────────────────────────
// Comments
// ─────────────────────────────────────────────

model Comment {
  id        String   @id @default(cuid())
  content   String
  issueId   String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])

  @@index([issueId])
  @@map("comments")
}

// ─────────────────────────────────────────────
// Sprints
// ─────────────────────────────────────────────

model Sprint {
  id        String    @id @default(cuid())
  name      String
  goal      String?
  status    String    @default("PLANNING") // PLANNING, ACTIVE, COMPLETED
  startDate DateTime?
  endDate   DateTime?
  projectId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  // AI-generated retrospective summary stored as JSON string
  retrospective String?

  @@index([projectId])
  @@map("sprints")
}

// ─────────────────────────────────────────────
// Attachments
// ─────────────────────────────────────────────

model Attachment {
  id         String   @id @default(cuid())
  filename   String
  url        String
  mimeType   String?
  size       Int?
  issueId    String
  uploaderId String
  createdAt  DateTime @default(now())

  issue    Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  uploader User  @relation(fields: [uploaderId], references: [id])

  @@index([issueId])
  @@map("attachments")
}

// ─────────────────────────────────────────────
// Audit Logs (Activity tracking)
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  action     String // CREATED, UPDATED, DELETED, STATUS_CHANGED, ASSIGNED, etc.
  entityType String // ISSUE, PROJECT, SPRINT, COMMENT, etc.
  entityId   String
  userId     String?
  metadata   String? // JSON string with old/new values
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// Time Tracking / Work Logs
// ─────────────────────────────────────────────

model WorkLog {
  id               String   @id @default(cuid())
  timeSpentMinutes Int
  description      String?
  issueId          String
  userId           String
  loggedAt         DateTime @default(now())
  createdAt        DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([issueId])
  @@index([userId])
  @@map("work_logs")
}

// ─────────────────────────────────────────────
// Git Commit Attachments
// ─────────────────────────────────────────────

model GitCommit {
  id           String   @id @default(cuid())
  hash         String
  shortHash    String
  message      String
  authorName   String
  authorAvatar String?
  url          String?
  branch       String?
  issueId      String
  createdAt    DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([hash])
  @@map("git_commits")
}

// ─────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  type      String // ISSUE_ASSIGNED, ISSUE_COMMENTED, SPRINT_STARTED, MENTIONED, etc.
  title     String
  message   String
  userId    String
  isRead    Boolean  @default(false)
  linkUrl   String? // Deep link to the relevant page
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// GitHub Repositories
// ─────────────────────────────────────────────

model Repository {
  id             String   @id @default(cuid())
  name           String
  fullName       String   // e.g. "octocat/Hello-World"
  owner          String   // e.g. "octocat"
  githubRepoId   Int?
  url            String
  defaultBranch  String   @default("main")
  authType       String   @default("PAT") // OAUTH, PAT
  encryptedToken String?
  webhookSecret  String?
  projectId      String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pullRequests PullRequest[]

  @@map("repositories")
}

// ─────────────────────────────────────────────
// Pull Requests
// ─────────────────────────────────────────────

model PullRequest {
  id           String    @id @default(cuid())
  githubPrId   Int?
  number       Int
  title        String
  url          String
  branch       String
  targetBranch String    @default("main")
  state        String    @default("OPEN") // OPEN, CLOSED, MERGED
  authorName   String?
  authorAvatar String?
  repositoryId String
  issueId      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  mergedAt     DateTime?
  closedAt     DateTime?

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  issue      Issue?      @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@unique([repositoryId, number])
  @@index([repositoryId])
  @@index([issueId])
  @@map("pull_requests")
}

// ─────────────────────────────────────────────
// Workspace Security Policy
// ─────────────────────────────────────────────
model WorkspaceSecurityPolicy {
  id                      String   @id @default(cuid())
  workspaceId             String   @unique
  enforceTwoFactor        Boolean  @default(false)
  restrictProjectCreation Boolean  @default(true)
  publicIssuesRead        Boolean  @default(false)
  sessionTimeoutHours     Int      @default(24)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_security_policies")
}

// ─────────────────────────────────────────────
// Workspace Invitations
// ─────────────────────────────────────────────
model WorkspaceInvitation {
  id          String   @id @default(cuid())
  email       String
  role        String   @default("DEVELOPER")
  token       String   @unique
  workspaceId String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([email, workspaceId])
  @@map("workspace_invitations")
}

// ─────────────────────────────────────────────
// Notification Settings
// ─────────────────────────────────────────────
model NotificationSetting {
  id               String   @id @default(cuid())
  userId           String   @unique
  emailAlerts      Boolean  @default(true)
  assignmentAlerts Boolean  @default(true)
  mentionAlerts    Boolean  @default(true)
  prAlerts         Boolean  @default(true)
  slaAlerts        Boolean  @default(true)
  weeklyDigest     Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

// ─────────────────────────────────────────────
// Billing & Subscriptions
// ─────────────────────────────────────────────
model WorkspaceSubscription {
  id                 String   @id @default(cuid())
  workspaceId        String   @unique
  tier               String   @default("FREE")
  interval           String   @default("MONTHLY")
  status             String   @default("ACTIVE")
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)
  paymentBrand       String?
  paymentLast4       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_subscriptions")
}

model BillingInvoice {
  id          String   @id @default(cuid())
  number      String   @unique
  amount      Float
  currency    String   @default("USD")
  status      String   @default("PAID")
  date        DateTime @default(now())
  pdfUrl      String?
  period      String?
  planName    String?
  workspaceId String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("billing_invoices")
}

// ─────────────────────────────────────────────
// Deployments
// ─────────────────────────────────────────────
model Deployment {
  id          String   @id @default(cuid())
  environment String   // production, staging, preview
  status      String   // success, pending, failed
  version     String
  commitSha   String?
  url         String?
  deployedAt  DateTime @default(now())
  projectId   String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("deployments")
}

// ─────────────────────────────────────────────
// Webhook Events (Idempotency & Replay Protection)
// ─────────────────────────────────────────────
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String   // GITHUB, STRIPE, PAYMENT
  eventId     String   // Provider's delivery ID or event ID (e.g. x-github-delivery, evt_xxx)
  eventType   String   // pull_request, checkout.session.completed, etc.
  payload     String?  // JSON stringified payload
  status      String   @default("PROCESSED") // PROCESSED, FAILED, IGNORED
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([provider, eventId])
  @@index([provider, eventId])
  @@map("webhook_events")
}

// ─────────────────────────────────────────────
// OTP & Two-Factor Authentication Verifications
// ─────────────────────────────────────────────
enum OtpPurpose {
  SIGNUP
  LOGIN
  PASSWORD_RESET
  EMAIL_CHANGE
}

model EmailVerification {
  id          String     @id @default(cuid())
  challengeId String?    @unique @default(cuid())
  userId      String?
  email       String
  otpHash     String     // HMAC-SHA256 hash of the 6-digit OTP
  purpose     OtpPurpose
  payload     String?    // Serialized JSON for pending registration/reset data
  expiresAt   DateTime
  attempts    Int        @default(0)
  verifiedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([challengeId])
  @@index([expiresAt])
  @@index([purpose])
  @@map("email_verifications")
}

// ─────────────────────────────────────────────
// Security Events (Audit Logging)
// ─────────────────────────────────────────────
model SecurityEvent {
  id          String   @id @default(cuid())
  userId      String?
  workspaceId String?
  eventType   String   // LOGIN_SUCCESS, LOGIN_FAILURE, OTP_REQUEST, OTP_LOCKOUT, SESSION_REVOKED, IDOR_ATTEMPT, WEBHOOK_REJECTED
  ipAddress   String?
  userAgent   String?
  metadata    String?  // JSON stringified metadata
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([workspaceId])
  @@index([eventType])
  @@index([createdAt])
  @@map("security_events")
}


