# ==============================================================================
# DevFlow API Backend Environment Configuration Template (.env.example)
# ==============================================================================

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devflow?schema=public"
DIRECT_URL=""

# Server & Network
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Security Secrets
JWT_SECRET="dF!9xQ#mK7$pL2vR8@wN3hY6&jT0cA5eB4gU1sZ"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
OTP_HASH_SECRET="devflow-otp-hash-secret-hmac-32b"
ENCRYPTION_KEY="devflow-default-encryption-secret-key-32b"
URL_SIGNING_SECRET=""

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# AI Intelligence
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Email & SMTP
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM='"DevFlow Security" <security@devflow.io>'

# File Storage
STORAGE_DRIVER="local"
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=10
AWS_REGION="us-east-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET="devflow-attachments"
S3_ENDPOINT=""

# GitHub Integration
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:4000/api/github/oauth/callback"
GITHUB_WEBHOOK_SECRET="whsec_devflow_local_test_key_xyz"

# Billing & Payments
STRIPE_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET="whsec_devflow_payment_test_secret_9988"
